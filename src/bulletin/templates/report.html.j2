<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ report_name }}</title>
  <style>
{{ report_css }}
{{ css_vars }}
  </style>
  {% if head_scripts %}{{ head_scripts }}{% endif %}
</head>
<body>
  <div class="bn-report">
    {% if show_header %}
    <header class="bn-report__header">
      <span class="bn-report__title">{{ report_name }}</span>
      <time class="bn-report__date" datetime="{{ report_date_iso }}">{{ report_date }}</time>
    </header>
    {% endif %}
    <main class="bn-report__body">
      {{ content_html }}
    </main>
  </div>
  <script>{{ report_js }}</script>
</body>
</html>
